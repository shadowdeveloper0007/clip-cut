# ClipClean Configuration
# Copy this file to .env and fill in values as needed.
# All settings below are optional — the app works with defaults.

# ──────────────────────────────────────────────
# Optional: Groq API key for AI-powered transcription
# Get a free key at https://console.groq.com
# ──────────────────────────────────────────────
# GROQ_API_KEY=gsk_your_key_here

# ──────────────────────────────────────────────
# Server settings (defaults shown)
# ──────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000

# ──────────────────────────────────────────────
# Processing limits
# ──────────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=1024
# MAX_DURATION_SECONDS=1800
# MAX_CONCURRENT_JOBS=2
# JOB_TIMEOUT_SECONDS=3600
# CLEANUP_AGE_SECONDS=3600

# ──────────────────────────────────────────────
# FFmpeg paths (if not on system PATH)
# ──────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
